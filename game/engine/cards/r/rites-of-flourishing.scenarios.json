{
  "schema": "CrankCardScenarios@1",
  "card": "Rites of Flourishing",
  "scenarios": [
    {
      "name": "Each player's draw step: that player draws an additional card -- Maya's turn 2 and Rob's turn 3 (Rob went first, so no draw step on turn 1, CR 103.8a)",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Rites of Flourishing"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "UPKEEP",
            "settle": true
          }
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "hand",
              "count": 0
            },
            {
              "seat": 1,
              "zone": "hand",
              "count": 0
            }
          ]
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1",
            "settle": true
          }
        },
        {
          "expect": [
            {
              "seat": 1,
              "zone": "hand",
              "count": 2
            },
            {
              "seat": 0,
              "zone": "hand",
              "count": 0
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1",
            "settle": true
          }
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 0,
          "zone": "hand",
          "count": 2
        }
      ]
    },
    {
      "name": "Rob may play a second land on his turn, and not a third",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Rites of Flourishing"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest",
            "Forest",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest"
              },
              "count": 3
            }
          ]
        },
        {
          "play": "Forest"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest"
              },
              "count": 2
            }
          ]
        },
        {
          "play": "Forest"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest"
          ]
        }
      ]
    },
    {
      "name": "Each player's: Maya plays two lands in her own turn though Rob controls it, and not a third",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Rites of Flourishing"
          ]
        },
        {
          "seat": 1,
          "zone": "hand",
          "cards": [
            "Forest",
            "Forest",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1",
            "settle": true
          }
        },
        {
          "play": "Forest",
          "seat": 1
        },
        {
          "play": "Forest",
          "seat": 1
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest",
                "seat": 1
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 1,
          "controls": [
            "Forest",
            "Forest"
          ]
        }
      ]
    },
    {
      "name": "Each turn anew: Rob plays two on turn 1 and two more on turn 3",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Rites of Flourishing"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest",
            "Forest",
            "Forest",
            "Forest",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "play": "Forest"
        },
        {
          "play": "Forest"
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1",
            "settle": true
          }
        },
        {
          "play": "Forest"
        },
        {
          "play": "Forest"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Forest",
            "Forest",
            "Forest",
            "Forest",
            "Rites of Flourishing"
          ]
        }
      ]
    },
    {
      "name": "Two of them: three lands each turn, and two more cards in each draw step",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Rites of Flourishing",
            "Rites of Flourishing"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest",
            "Forest",
            "Forest",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "play": "Forest"
        },
        {
          "play": "Forest"
        },
        {
          "play": "Forest"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest"
              },
              "count": 0
            }
          ]
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1",
            "settle": true
          }
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "hand",
          "count": 3
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest"
          ]
        }
      ]
    },
    {
      "name": "Without the card, one land play a turn, as ever",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "play": "Forest"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest"
          ]
        }
      ]
    },
    {
      "name": "Offered from untapped lands with an empty pool, as the table's matches are: the card itself cast without tapping first",
      "pooledTaps": true,
      "xTaps": true,
      "phyrexianTaps": true,
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Forest",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Rites of Flourishing"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Rites of Flourishing"
              },
              "count": 1
            }
          ]
        },
        {
          "cast": "Rites of Flourishing"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Forest",
            "Rites of Flourishing",
            "Wastes",
            "Wastes"
          ]
        }
      ]
    }
  ]
}
