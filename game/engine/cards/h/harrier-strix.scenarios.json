{
  "schema": "CrankCardScenarios@1",
  "card": "Harrier Strix",
  "fixtures": {
    "Ogre": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Ogre"
      ],
      "manaCost": "{2}{R}",
      "colors": [
        "R"
      ],
      "power": 3,
      "toughness": 3
    },
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "Cast from an untapped Island: it enters and taps Maya's Ogre; any permanent is a target, itself too",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Harrier Strix"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Ogre",
            "Mountain"
          ]
        }
      ],
      "steps": [
        {
          "cast": "Harrier Strix"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Harrier Strix",
                  "Island",
                  "Mountain",
                  "Ogre"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Ogre"
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "stack": 0
        },
        {
          "seat": 1,
          "tapped": "Ogre"
        },
        {
          "seat": 1,
          "tapped": "Mountain",
          "is": false
        },
        {
          "seat": 0,
          "tapped": "Harrier Strix",
          "is": false
        },
        {
          "seat": 0,
          "keywords": {
            "card": "Harrier Strix",
            "has": [
              "Flying"
            ]
          }
        }
      ]
    },
    {
      "name": "Rob may pick a land: Maya's Mountain is tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Harrier Strix"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Ogre",
            "Mountain"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "cast": "Harrier Strix"
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Mountain"
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 1,
          "tapped": "Mountain"
        },
        {
          "seat": 1,
          "tapped": "Ogre",
          "is": false
        }
      ]
    },
    {
      "name": "{2}{U}: Rob draws the Bear, then discards the Forest he chooses",
      "library": [
        "Bear"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Harrier Strix",
            "Island",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "activate": "Harrier Strix"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Bear",
                  "Forest"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Forest"
          ]
        }
      ],
      "expect": [
        {
          "stack": 0
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Bear"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Forest"
          ]
        },
        {
          "seat": 0,
          "tapped": "Harrier Strix",
          "is": false
        }
      ]
    }
  ]
}
