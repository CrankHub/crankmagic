    {
      "name": "Offered from untapped lands with an empty pool, as the table's matches are: the card itself cast without tapping first",
      "pooledTaps": true,
      "xTaps": true,
      "phyrexianTaps": true,
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Forest",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Heartbeat of Spring"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Heartbeat of Spring"
              },
              "count": 1
            }
          ]
        },
        {
          "cast": "Heartbeat of Spring"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Forest",
            "Heartbeat of Spring",
            "Wastes",
            "Wastes"
          ]
        }
      ]
