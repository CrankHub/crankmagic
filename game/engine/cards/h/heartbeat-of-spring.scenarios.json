{
  "schema": "CrankCardScenarios@1",
  "card": "Heartbeat of Spring",
  "fixtures": {
    "Rock": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{1}",
      "colors": [],
      "abilities": [
        {
          "id": "rock-mana",
          "kind": "mana",
          "tapSelf": true,
          "produces": {
            "C": 1
          }
        }
      ]
    }
  },
  "scenarios": [
    {
      "name": "Rob taps a Forest: {G}{G}; a Wastes: {C}{C}; Maya taps an Island: {U}{U} -- any player's, any land",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Heartbeat of Spring",
            "Forest",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest"
        },
        {
          "tap": "Wastes"
        },
        {
          "pass": 1
        },
        {
          "tap": "Island",
          "seat": 1
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "G": 2,
            "C": 2
          }
        },
        {
          "seat": 1,
          "pool": {
            "U": 2,
            "G": 0
          }
        }
      ]
    },
    {
      "name": "A land that makes two mana of one type ({C}{C}): one more {C}, with no type to pick",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Heartbeat of Spring",
            "Ancient Tomb"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Ancient Tomb"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "C": 3
          }
        }
      ]
    },
    {
      "name": "Something that is not a land adds only its own mana",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Heartbeat of Spring",
            "Rock"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Rock"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "C": 1
          }
        }
      ]
    },
    {
      "name": "A land that makes two types at once ({B}{R}): Rob is offered each type to add one more of, and picks {R}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Heartbeat of Spring",
