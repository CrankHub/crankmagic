      "expect": [
        {
          "seat": 0,
          "pool": {
            "R": 3
          }
        }
      ]
    },
    {
      "name": "Maya's own two-type land, tapped in her turn: Maya is the one who picks, and she gets the mana",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Heartbeat of Spring"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Rakdos Carnarium"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1",
            "settle": true
          }
        },
        {
          "tap": "Rakdos Carnarium",
          "seat": 1,
          "pick": [
            "B"
          ]
        }
      ],
      "expect": [
        {
          "seat": 1,
          "pool": {
            "B": 2,
            "R": 1
          }
        },
        {
          "seat": 0,
          "pool": {
            "B": 0,
            "R": 0
          }
        }
      ]
    },
    {
      "name": "A land that costs {1} to tap for {R}{G} (Mossfire Valley): the {1} paid from the pool, and one more of the type Rob picks",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Heartbeat of Spring",
            "Wastes",
            "Mossfire Valley"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "tap": "Mossfire Valley",
          "pick": [
            "G"
          ]
