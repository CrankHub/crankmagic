          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Rakdos Carnarium"
              },
              "count": 2
            }
          ]
        },
        {
          "tap": "Rakdos Carnarium",
          "pick": [
            "R"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "B": 1,
            "R": 2
          }
        }
      ]
    },
    {
      "name": "The same land, picking {B}: {B}{B}{R}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Heartbeat of Spring",
            "Rakdos Carnarium"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Rakdos Carnarium",
          "pick": [
            "B"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "B": 2,
            "R": 1
          }
        }
      ]
    },
    {
      "name": "Two of them and a land making two types: each picks a type -- three different ways (BB, BR, RR), each offered",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Heartbeat of Spring",
            "Heartbeat of Spring",
            "Rakdos Carnarium"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Rakdos Carnarium"
              },
              "count": 3
            }
          ]
        },
        {
          "tap": "Rakdos Carnarium",
          "pick": [
            "B",
            "R"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "B": 2,
            "R": 2
          }
        }
      ]
    },
    {
      "name": "Two of them on a land making one type: each adds one more, and nothing is asked",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Heartbeat of Spring",
