{
  "schema": "CrankCardScenarios@1",
  "card": "Dictate of Kruphix",
  "scenarios": [
    {
      "name": "Each player's draw step: that player draws an additional card -- Maya's turn 2 and Rob's turn 3 (Rob went first, so no draw step on turn 1, CR 103.8a)",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Dictate of Kruphix"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "UPKEEP",
            "settle": true
          }
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "hand",
              "count": 0
            },
            {
              "seat": 1,
              "zone": "hand",
              "count": 0
            }
          ]
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1",
            "settle": true
          }
        },
        {
          "expect": [
            {
              "seat": 1,
              "zone": "hand",
              "count": 2
            },
            {
              "seat": 0,
              "zone": "hand",
              "count": 0
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1",
            "settle": true
          }
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 0,
          "zone": "hand",
          "count": 2
        }
      ]
    },
    {
      "name": "Maya's Dictate works for Rob too: \"each player's\", whoever controls it",
      "setup": [
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Dictate of Kruphix"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1",
            "settle": true
          }
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 0,
          "zone": "hand",
          "count": 2
        }
      ]
    },
    {
      "name": "Two of them: each draws two additional cards on her turn",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Dictate of Kruphix",
            "Dictate of Kruphix"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1",
            "settle": true
          }
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "hand",
          "count": 3
        }
      ]
    },
    {
      "name": "Three players: the draw step of each of them, in turn",
      "seats": 3,
      "setup": [
        {
          "seat": 2,
          "zone": "battlefield",
          "cards": [
            "Dictate of Kruphix"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1",
            "settle": true
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 1,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 2,
          "zone": "hand",
          "count": 2
        }
      ]
    },
    {
      "name": "Flash: Rob casts it in Maya's upkeep from untapped lands (the table's way), and her draw step that turn gives her the additional card",
      "pooledTaps": true,
      "xTaps": true,
      "phyrexianTaps": true,
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Island",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Dictate of Kruphix"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "UPKEEP",
            "settle": true
          }
        },
        {
          "pass": 1
        },
        {
          "cast": "Dictate of Kruphix",
          "seat": 0
        },
        {
          "resolve": true
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1",
            "settle": true
          }
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 0,
          "controls": [
            "Dictate of Kruphix",
            "Island",
            "Island",
            "Wastes"
          ]
        }
      ]
    },
    {
      "name": "Cast on Rob's own turn 1 from tapped lands: Maya's turn 2 draw step gives her the additional card",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Island",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Dictate of Kruphix"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "tap": "Island"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Dictate of Kruphix"
        },
        {
          "resolve": true
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1",
            "settle": true
          }
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 0,
          "zone": "hand",
          "count": 0
        }
      ]
    }
  ]
}
