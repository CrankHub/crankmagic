{
  "schema": "CrankCardScenarios@1",
  "card": "Gold Pan",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    },
    "Their Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "Cast from untapped lands with nothing tapped by hand: offered once",
      "pooledTaps": true,
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Gold Pan"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Gold Pan"
              },
              "count": 1
            }
          ]
        },
        {
          "cast": "Gold Pan"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "stack": 1
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Gold Pan",
            "Treasure",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "stack": 0
        }
      ]
    },
    {
      "name": "Equip {1}: only Rob's Bear is offered, not Maya's; the Bear is 3/3",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Gold Pan",
            "Bear",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Their Bear"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Gold Pan"
              },
              "count": 1,
              "targets": [
                [
                  "Bear"
                ]
              ]
            }
          ]
        },
        {
          "activate": "Gold Pan",
          "targets": [
            {
              "card": "Bear"
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "stats": {
            "card": "Bear",
            "power": 3,
            "toughness": 3
          }
        },
        {
          "seat": 1,
          "stats": {
            "card": "Their Bear",
            "power": 2,
            "toughness": 2
          }
        }
      ]
    },
    {
      "name": "No creature of Rob's: equip is not offered",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Gold Pan",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Their Bear"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Gold Pan"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Gold Pan",
            "Wastes"
          ]
        }
      ]
    }
  ]
}
